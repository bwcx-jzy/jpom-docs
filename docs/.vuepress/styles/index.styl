@require '~vuepress-plugin-tabs/dist/themes/default.styl';

// 评论区颜色重置
.gt-container {
	.gt-ico-tip {
		&::after {
			content: '。( Win + . ) 或 ( ⌃ + ⌘ + ␣ ) 打开表情';
			color: #999;
			font-size: 0.8rem;
		}
	}

	.gt-meta {
		border-color: var(--borderColor) !important;
	}

	.gt-comments-null {
		color: var(--textColor);
		opacity: 0.5;
	}

	.gt-header-textarea {
		color: var(--textColor);
		background: rgba(180, 180, 180, 0.1) !important;
	}

	.gt-btn {
		border-color: $accentColor !important;
		background-color: $accentColor !important;
	}

	.gt-btn-preview {
		background-color: rgba(255, 255, 255, 0) !important;
		color: $accentColor !important;
	}

	a {
		color: $accentColor !important;
	}

	.gt-svg svg {
		fill: $accentColor !important;
	}

	.gt-comment-content, .gt-comment-admin .gt-comment-content {
		background-color: rgba(150, 150, 150, 0.1) !important;

		&:hover {
			box-shadow: 0 0 25px rgba(150, 150, 150, 0.5) !important;
		}

		.gt-comment-body {
			color: var(--textColor) !important;
		}
	}
}

// qq徽章
.qq {
	position: relative;
}

.qq::after {
	content: '可撩';
	background: $accentColor;
	color: #fff;
	padding: 0 5px;
	border-radius: 10px;
	font-size: 12px;
	position: absolute;
	top: -4px;
	right: -35px;
	transform: scale(0.85);
}

// demo模块图标颜色
body .vuepress-plugin-demo-block__wrapper {
	&, .vuepress-plugin-demo-block__display {
		border-color: rgba(160, 160, 160, 0.3);
	}

	.vuepress-plugin-demo-block__footer:hover {
		.vuepress-plugin-demo-block__expand::before {
			border-top-color: $accentColor !important;
			border-bottom-color: $accentColor !important;
		}

		svg {
			fill: $accentColor !important;
		}
	}
}

.animationLogo {
	animation: 5s ease 0s infinite backwards bounce;
}

/* 主要是通过控制translateY的值来操作y轴的距离实现弹跳效果 */
@keyframes bounce {
	0% {
		transform: translateY(-10px);
		animation-timing-function: ease-in;
		opacity: 1;
	}

	0% {
		transform: translateY(-20px);
		animation-timing-function: ease-in;
		opacity: 1;
	}

	10% {
		transform: translateY(-32px);
		animation-timing-function: ease-in;
		opacity: 1;
	}

	24% {
		opacity: 1;
	}

	40% {
		transform: translateY(-32px);
		animation-timing-function: ease-in;
	}

	62% {
		transform: translateY(-16px);
		animation-timing-function: ease-in;
	}

	82% {
		transform: translateY(-8px);
		animation-timing-function: ease-in;
	}

	92% {
		transform: translateY(-4px);
		animation-timing-function: ease-in;
	}

	25%, 55%, 75%, 90% {
		transform: translateY(0);
		animation-timing-function: ease-out;
	}

	100% {
		transform: translateY(0);
		animation-timing-function: ease-out;
		opacity: 1;
	}
}

.page-wwads {
	width: 100% !important;
	margin: 0;
}

.wwads-sticky, .page-wwads {
	border: 1px solid var(--borderColor, #ccc);
	min-height: 0 !important;
	align-items: center;
}

.wwads-cn:empty {
	border: none;
}

.page-wwads .wwads-img img {
	width: 80px !important;
}

.page-wwads .wwads-poweredby {
	width: 40px;
	position: absolute;
	right: 25px;
	bottom: 3px;
}

.wwads-content .wwads-text, .page-wwads .wwads-text {
	height: 100%;
	padding-top: 5px;
	display: block;
}

// ==================== 顶部导航优化 ====================
// 一级菜单收敛为 7 项后，这里做两件事：
// 1) 下拉面板位置/宽度微调，避免最左侧菜单把面板顶出屏幕、长文案挤成一行；
// 2) 窄屏（1280 / 1180 / 1024 常见笔记本宽度）逐级压缩字号与间距，保证一行放得下、不和站点名重叠。
.navbar
	.nav-dropdown
		min-width 12rem
		box-shadow 0 10px 28px rgba(0, 0, 0, 0.12)
		border-radius 0.4rem

	// 最左侧两项的下拉面板向右展开，否则 right:0 会把面板推到屏幕外
	.nav-item:first-child .nav-dropdown,
	.nav-item:nth-child(2) .nav-dropdown
		right auto
		left 0

	// 下拉面板内分组标题与条目之间的呼吸感
	.nav-dropdown .dropdown-item h4
		font-size 0.82rem
		font-weight 600
		opacity 0.75
		letter-spacing 0.02em

@media (max-width 1320px)
	.navbar .nav-links .nav-item
		margin-left 1rem

@media (max-width 1200px)
	.navbar
		padding-left 1rem
		padding-right 1rem

		.links
			padding-left 0.75rem

		.site-name
			font-size 1.15rem

		.nav-links
			.nav-item
				margin-left 0.6rem

			.nav-item .dropdown-title,
			.nav-item > a
				font-size 0.84rem

		.search-box input
			width 7.5rem

@media (max-width 1080px)
	.navbar
		.site-name
			display none

		.links
			padding-left 1rem

		.nav-links
			.nav-item
				margin-left 0.75rem

			.nav-item .dropdown-title,
			.nav-item > a
				font-size 0.86rem

